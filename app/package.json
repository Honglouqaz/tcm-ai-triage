{
  "name": "sishi-tcm",
  "version": "1.2.0",
  "private": true,
  "description": "四时辨证 — 离线中医辨证规则引擎（9 体质 / 47 证型 / 76 症状 / 73 首方剂 / 23 项化验）",
  "author": "江南烟雨红楼 <honglouqaz@users.noreply.github.com>",
  "homepage": "https://github.com/Honglouqaz/tcm-ai-triage",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:web": "node build-prepare.cjs",
    "test:engine": "node engine/test-engine.cjs",
    "serve": "npm run prepare:web && npx --yes http-server web -p 8799 -c-1",
    "start": "npm run prepare:web && electron .",
    "dist:linux": "npm run prepare:web && electron-builder --linux AppImage deb --publish never",
    "dist:win": "npm run prepare:web && electron-builder --win nsis portable --publish never",
    "cap:sync": "npm run prepare:web && cap sync android"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@capacitor/cli": "^6.2.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/android": "^6.2.0"
  },
  "build": {
    "appId": "uk.yanyusk.sishi",
    "productName": "四时辨证",
    "copyright": "MIT · 江南烟雨红楼",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "sishi-tcm-${version}-${arch}.${ext}",
      "synopsis": "离线中医辨证规则引擎",
      "description": "四时辨证：9 体质 / 47 证型 / 76 症状 / 73 首方剂 / 23 项化验指标，推理全在本地完成，不联网、不调用大模型。"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "四时辨证",
      "artifactName": "sishi-tcm-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "sishi-tcm-${version}-portable.${ext}"
    },
    "publish": null
  }
}
